# Copy to server/.env and fill in your own values.
# server/.env is git-ignored — never commit real credentials.

# Port the API listens on
PORT=8000

# MongoDB connection string (MongoDB Atlas or local)
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vtube
MONGODB_URI=

# Secret used to sign JWT auth tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=
